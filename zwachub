local function GetCurrentAttribute()
    local attrVal = nil
    pcall(function()
        local dataFolder = LocalPlayer:FindFirstChild("Data")
        if dataFolder then
            local stats = dataFolder:FindFirstChild("Stats")
            if stats then
                local attrObj = stats:FindFirstChild("Attribute")
                if attrObj then
                    if attrObj:IsA("ValueBase") then
                        attrVal = tostring(attrObj.Value)
                    else
                        attrVal = tostring(attrObj)
                    end
                else
                    local attrAttr = stats:GetAttribute("Attribute")
                    if attrAttr then attrVal = tostring(attrAttr) end
                end
            end
        end
    end)
    if not attrVal or attrVal == "" then
        return "None"
    end
    return attrVal
end

local function GetTargetMob()
    local livingFolder = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Living")
    if livingFolder then
        local targetName = QuestData[Settings.SelectedQuest].MobName
        for _, mob in pairs(livingFolder:GetChildren()) do
            if mob.Name == targetName and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                return mob
            end
        end
    end
    return nil
end

