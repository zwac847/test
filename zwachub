local function CreateTab(name)
    local Scroll = Instance.new("ScrollingFrame")
    Scroll.Size = UDim2.new(1, 0, 1, 0)
    Scroll.BackgroundTransparency = 1
    Scroll.ScrollBarThickness = 3
    Scroll.Visible = false
    Scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    Scroll.Parent = ContentArea
    
    local List = Instance.new("UIListLayout")
    List.Parent = Scroll
    List.Padding = UDim.new(0, 5)
    
    List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Scroll.CanvasSize = UDim2.new(0, 0, 0, List.AbsoluteContentSize.Y + 10)
    end)
    
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -6, 0, 28)
    Btn.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
    Btn.Text = name
    Btn.TextColor3 = Color3.fromRGB(180, 180, 180)
    Btn.TextSize = 12
    Btn.Font = Enum.Font.SourceSansSemibold
    Btn.Parent = Sidebar
    
    Tabs[name] = Scroll
    TabButtons[name] = Btn
    
    Btn.MouseButton1Click:Connect(function()
        for tName, tScroll in pairs(Tabs) do
            tScroll.Visible = (tName == name)
            TabButtons[tName].BackgroundColor3 = (tName == name) and Color3.fromRGB(180, 25, 25) or Color3.fromRGB(32, 32, 40)
            TabButtons[tName].TextColor3 = (tName == name) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
        end
    end)
    return Scroll
end

