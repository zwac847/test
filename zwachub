-- // PATH PATROL LOOP (Noktalar Arası Yürüme) // --
task.spawn(function()
    while task.wait(0.5) do
        if Settings.AutoPath and not Settings.AutoQuest then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                local hum = char.Humanoid
                local root = char.HumanoidRootPart
                local targetPos = Waypoints[CurrentWaypointIdx]
                
                hum:MoveTo(targetPos)
                StatusLabel.Text = "Path Patrol: Nokta " .. CurrentWaypointIdx .. "'e gidiliyor..."
                
                if (root.Position - targetPos).Magnitude < 5 then
                    CurrentWaypointIdx = (CurrentWaypointIdx % #Waypoints) + 1
                    task.wait(1)
                end
            end
        end
    end
end)

-- // AUTO ROLL LOOP // --
task.spawn(function()
    while task.wait(1.2) do
        local currentAttr = GetCurrentAttribute()
        if Settings.AutoRoll then
            local isWanted = false
            for targetName, enabled in pairs(Settings.TargetAttributes) do
                if enabled and string.lower(currentAttr) == string.lower(targetName) then
                    isWanted = true
                    break
                end
            end
            if isWanted then
                Settings.AutoRoll = false
                StatusLabel.Text = "HEDEF GELDI: " .. currentAttr .. "!"
            else
                if ItemRemote then
                    pcall(function() 
                        ItemRemote:FireServer("Item", "Rokakaka")
                        task.wait(0.8)
                        ItemRemote:FireServer("Item", "Unusual Arrow")
                    end)
                end
            end
        end
    end
end)

-- // FLIGHT / FARM ENGINE // --
RunService.Heartbeat:Connect(function()
    if Settings.AutoQuest and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local root = LocalPlayer.Character.HumanoidRootPart
        local activeQuest = QuestData[Settings.SelectedQuest]
        
        if CurrentState == "FARMING" then
            if CurrentTarget and CurrentTarget:FindFirstChild("HumanoidRootPart") then
                local mobPos = CurrentTarget.HumanoidRootPart.Position
                root.CFrame = CFrame.lookAt(mobPos + Vector3.new(0, HOVER_HEIGHT, 0), mobPos + Vector3.new(0, 0, 0.001))
            else
                root.CFrame = CFrame.lookAt(activeQuest.FarmPos + Vector3.new(0, HOVER_HEIGHT, 0), activeQuest.FarmPos + Vector3.new(0, 0, 0.001))
            end
        else
            root.CFrame = CFrame.new(activeQuest.NpcPos)
        end
        root.AssemblyLinearVelocity = Vector3.zero
    end
end)

-- // QUEST LOOP // --
task.spawn(function()
    while task.wait(0.15) do
        local currentAttr = GetCurrentAttribute()
        if Settings.AutoQuest and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local activeQuest = QuestData[Settings.SelectedQuest]
            StatusLabel.Text = "Görev: " .. Settings.SelectedQuest .. " | Attr: " .. currentAttr .. " | Kesilen: " .. KillCount .. "/" .. activeQuest.KillsRequired

            if CurrentState == "START_QUEST" then
                LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(activeQuest.NpcPos)
                task.wait(0.5)
                if QuestRemote then pcall(function() QuestRemote:InvokeServer("Start", activeQuest.RemoteArg) end) end
                KillCount = 0
                CurrentTarget, LastTarget = nil, nil
                task.wait(0.5)
                CurrentState = "FARMING"

            elseif CurrentState == "FARMING" then
                CurrentTarget = GetTargetMob()
                if CurrentTarget ~= LastTarget then
                    if LastTarget and (not LastTarget:FindFirstChild("Humanoid") or LastTarget.Humanoid.Health <= 0 or not LastTarget.Parent) then
                        KillCount = KillCount + 1
                    end
                    LastTarget = CurrentTarget
                end

                if KillCount >= activeQuest.KillsRequired then
                    CurrentState = "COMPLETE_QUEST"
                elseif CurrentTarget then
                    if Settings.SkillE and (tick() - Settings.LastE) >= 7 then
                        PressKey(Enum.KeyCode.E)
                        Settings.LastE = tick()
                    end
                    if Settings.SkillT then PressKey(Enum.KeyCode.T) end
                    if Settings.SkillR then PressKey(Enum.KeyCode.R) end
                    if Settings.SkillX then PressKey(Enum.KeyCode.X) end
                end

            elseif CurrentState == "COMPLETE_QUEST" then
                LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(activeQuest.NpcPos)
                task.wait(0.5)
                if QuestRemote then
                    pcall(function()
                        QuestRemote:InvokeServer("Response", activeQuest.RemoteArg)
                        task.wait(0.3)
                        QuestRemote:InvokeServer("Start", activeQuest.RemoteArg)
                    end)
                end
                KillCount = 0
                CurrentTarget, LastTarget = nil, nil
                task.wait(0.5)
                CurrentState = "FARMING"
            end
        end
    end
end)
